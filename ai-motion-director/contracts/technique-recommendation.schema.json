{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recomendação de técnicas (saída do Motion Graphics Intelligence)",
  "type": "object",
  "required": [
    "items",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "technique_id",
          "narrative_goal",
          "expected_effect",
          "moment",
          "justification",
          "simpler_alternative"
        ],
        "additionalProperties": false,
        "properties": {
          "technique_id": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "narrative_goal": {
            "type": "string",
            "minLength": 1
          },
          "expected_effect": {
            "type": "string",
            "minLength": 1
          },
          "moment": {
            "type": "string",
            "minLength": 1
          },
          "justification": {
            "type": "string",
            "minLength": 1
          },
          "simpler_alternative": {
            "type": "string",
            "minLength": 1
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "status": {
      "$ref": "common.schema.json#/definitions/status"
    },
    "evidence": {
      "$ref": "common.schema.json#/definitions/evidence"
    }
  }
}
