{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Apelido de estilo: preset de direção visual/movimento reutilizável",
  "type": "object",
  "required": [
    "id",
    "name",
    "palette",
    "easing",
    "tempo",
    "motion_language",
    "sound",
    "avoid"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/definitions/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "palette": {
      "type": "object",
      "required": [
        "bg",
        "ink",
        "accent"
      ],
      "additionalProperties": false,
      "properties": {
        "bg": {
          "type": "string",
          "minLength": 1
        },
        "ink": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "minLength": 1
        },
        "dim": {
          "type": "string"
        }
      }
    },
    "easing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tempo": {
      "type": "string",
      "minLength": 1
    },
    "motion_language": {
      "type": "string",
      "minLength": 1
    },
    "sound": {
      "type": "string",
      "minLength": 1
    },
    "avoid": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
