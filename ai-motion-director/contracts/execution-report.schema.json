{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resultado de execução (renderização/produção) — fatos, não opinião",
  "type": "object",
  "required": [
    "tool",
    "command",
    "started_at",
    "ok",
    "outputs",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "duration_s": {
      "type": "number",
      "minimum": 0
    },
    "ok": {
      "type": "boolean"
    },
    "frames": {
      "type": "integer",
      "minimum": 0
    },
    "fps": {
      "type": "integer",
      "minimum": 1
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "capture": {
      "type": "string",
      "minLength": 1
    },
    "audio": {
      "type": "string",
      "enum": [
        "none",
        "file",
        "synth-sfx"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "page_messages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "$ref": "common.schema.json#/definitions/status"
    },
    "evidence": {
      "$ref": "common.schema.json#/definitions/evidence"
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": false
      }
    },
    "required": [
      "ok"
    ]
  },
  "then": {
    "required": [
      "errors"
    ]
  }
}
